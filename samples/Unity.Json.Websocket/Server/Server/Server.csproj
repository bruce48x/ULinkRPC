<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <UseAppHost>false</UseAppHost>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Samples.Server</RootNamespace>
        <AssemblyName>Samples.Server</AssemblyName>
        <ULinkRPCGenerateServer>true</ULinkRPCGenerateServer>
        <ULinkRPCServerGeneratedNamespace>Game.Rpc.Server.Generated</ULinkRPCServerGeneratedNamespace>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="ULinkRPCGenerateServer" />
        <CompilerVisibleProperty Include="ULinkRPCServerGeneratedNamespace" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\Client\Packages\com.samples.contracts\**\*.cs"/>
        <ProjectReference Include="..\..\..\..\src\ULinkRPC.Analyzers\ULinkRPC.Analyzers.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="Analyzer"
                          PrivateAssets="all" />
        <ProjectReference Include="..\..\..\..\src\ULinkRPC.Server\ULinkRPC.Server.csproj" />
        <ProjectReference Include="..\..\..\..\src\ULinkRPC.Serializer.Json\ULinkRPC.Serializer.Json.csproj" />
        <ProjectReference Include="..\..\..\..\src\ULinkRPC.Transport.WebSocket\ULinkRPC.Transport.WebSocket.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Runtime\**\*.cs" />
        <Compile Remove="Transports\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>
