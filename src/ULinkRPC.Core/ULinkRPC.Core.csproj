<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>ULinkRPC.Core</PackageId>
    <Version>0.11.6</Version>
    <Authors>ULinkRPC</Authors>
    <Description>ULinkRPC core abstractions, contracts, envelopes, and framing helpers.</Description>
    <PackageTags>rpc;unity;dotnet;transport</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="buildTransitive\ULinkRPC.Core.props" Pack="true" PackagePath="buildTransitive" />
    <None Include="..\ULinkRPC.Analyzers\bin\$(Configuration)\netstandard2.0\ULinkRPC.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false"
          Condition="Exists('..\ULinkRPC.Analyzers\bin\$(Configuration)\netstandard2.0\ULinkRPC.Analyzers.dll')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ULinkRPC.Analyzers\ULinkRPC.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ULinkRPC.Client" />
    <InternalsVisibleTo Include="ULinkRPC.Server" />
    <InternalsVisibleTo Include="ULinkRPC.Transport.Kcp" />
    <InternalsVisibleTo Include="ULinkRPC.Transport.Loopback" />
    <InternalsVisibleTo Include="ULinkRPC.Transport.Tcp" />
    <InternalsVisibleTo Include="ULinkRPC.Transport.WebSocket" />
    <InternalsVisibleTo Include="ULinkRPC.Transport.Tests" />
  </ItemGroup>
</Project>
